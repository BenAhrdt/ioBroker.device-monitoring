  "native": {},
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "Device or service connected",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.deviceInfo",
      "type": "state",
      "common": {
        "role": "json",
        "name": "Device information",
        "type": "string",
        "read": true,
        "write": false,
        "def": "{\"devices\":[]}"
      },
      "native": {}
    },
    {
      "_id": "devices",
      "type": "folder",
      "common": {
        "name": "Devices"
      },
      "native": {
        "devices": [],
        "nextDeviceNumber": 1,
        "functionTemplates": {}
      }
    }
  ]
